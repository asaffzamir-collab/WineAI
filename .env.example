# Supabase (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth for sign-in (from Google Cloud Console → APIs & Services → Credentials)
# Required when using Supabase Auth with Google provider (local: config.toml references these)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Client-side Google Client ID for Google Identity Services (same ID as above)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# OpenAI (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key
