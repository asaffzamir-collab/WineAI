# Supabase (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth for sign-in (from Google Cloud Console → APIs & Services → Credentials)
# Required when using Supabase Auth with Google provider (local: config.toml references these)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Client-side Google Client ID for Google Identity Services (same ID as above)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# OpenAI (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key

# Serper.dev image search (from https://serper.dev — used for wine bottle images)
SERPER_API_KEY=your-serper-api-key

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@winejourney.co

# Vercel Cron secret (auto-set by Vercel, or generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
CRON_SECRET=your-cron-secret
